{
  "name": "arawms-be",
  "version": "1.0.0",
  "description": "Express.js Backend API for ARAWMS with MongoDB Atlas",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate:sku-index": "node scripts/drop-obsolete-sku-index.mjs",
    "migrate:catalog-offline-index": "node scripts/ensure-catalog-offline-indexes.mjs",
    "check:catalog-offline-index": "node scripts/check-catalog-offline-indexes.mjs",
    "backfill:product-media": "node scripts/backfill-product-media.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:packing": "node --experimental-vm-modules node_modules/jest/bin/jest.js packingVerification.test.js",
    "test:inbound": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.finishedGoodsInbound.config.cjs --runInBand"
  },
  "keywords": [
    "express",
    "nodejs",
    "mongodb",
    "mongoose",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.11.4",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.1"
  }
}
